<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless tests for the game-independent mod sync code. Not part of the mod build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="TestFolders.cs" />
    <Compile Include="..\..\ModSync\ModEntry.cs" />
    <Compile Include="..\..\ModSync\ModInventory.cs" />
    <Compile Include="..\..\ModSync\HostModSet.cs" />
    <Compile Include="..\..\ModSync\SyncPlanner.cs" />
    <Compile Include="..\..\ModSync\MessageChunks.cs" />
    <Compile Include="..\..\ModSync\SettingsRules.cs" />
    <Compile Include="..\..\ModSync\TransferRules.cs" />
    <Compile Include="..\..\ModSync\TransferSender.cs" />
    <Compile Include="..\..\ModSync\TransferReceiver.cs" />
    <Compile Include="..\..\ModSync\ModCache.cs" />
    <Compile Include="..\..\ModSync\SwapJournal.cs" />
    <Compile Include="..\..\ModSync\JournalPlanner.cs" />
    <Compile Include="..\..\ModSync\JournalApplier.cs" />
    <Compile Include="..\..\ModSync\HelperScript.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game's copy fails .NET Framework strong-name validation when loaded outside Unity, so use the signed package -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
