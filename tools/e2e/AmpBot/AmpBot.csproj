<Project Sdk="Microsoft.NET.Sdk">
  <!-- Scripted AMP peer for the in-game end-to-end tests (docs/superpowers/plans/2026-10-10-e2e-harness.md). Not part of the mod.
       It compiles AMP's pure mod sync files directly; AMP.dll itself can't load outside Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\..\ModSync\ModEntry.cs" />
    <Compile Include="..\..\..\ModSync\ModInventory.cs" />
    <Compile Include="..\..\..\ModSync\HostModSet.cs" />
    <Compile Include="..\..\..\ModSync\SyncPlanner.cs" />
    <Compile Include="..\..\..\ModSync\MessageChunks.cs" />
    <Compile Include="..\..\..\ModSync\TransferRules.cs" />
    <Compile Include="..\..\..\ModSync\TransferSender.cs" />
    <Compile Include="..\..\..\ModSync\TransferReceiver.cs" />
    <Compile Include="..\..\..\ModSync\ModCache.cs" />
    <Compile Include="..\..\..\ModSync\SettingsRules.cs" />
    <Compile Include="..\..\..\Network\Nat\JoinCodes.cs" />
    <Compile Include="..\..\..\Tests\ModSyncTests\FakeIgd.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Netamite">
      <HintPath>..\..\..\..\ampdeps\Netamite.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- The game's copy fails .NET Framework strong-name validation when loaded outside Unity, so use the signed package -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
